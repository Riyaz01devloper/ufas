

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  CONTACT
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  loginId  String   @unique
  email    String   @unique
  password String
  role     UserRole @default(CONTACT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contacts  Contact?
  sessions Session[]
}

model Session {
  id               Int     @id @default(autoincrement())
  userId           Int
  refreshTokenHash String
  ip               String  @db.VarChar(45)
  userAgent        String
  revoked          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

enum ProductType {
  GOODS
  SERVICE
  COMBO
}

enum FurnitureCategory {
  CHAIRS
  TABLES
  SOFAS
  BEDS
  WARDROBES
  CABINETS
  DESKS
  DINING
  OFFICE_FURNITURE
  OUTDOOR_FURNITURE
  STORAGE
  MATTRESSES
  OTHER
}

model Product {
  id        Int               @id @default(autoincrement())
  name      String
  brandName String?
  type      ProductType       @default(GOODS)
  category  FurnitureCategory

  purchasingPrice   Float
  sellingPrice      Float
  availableQuantity Int
  sales             Sale[]
  purchases         Purchase[]
  maxMargin Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ContactType {
  CUSTOMER
  VENDOR
  BOTH
}

model Contact {
  id        Int         @id @default(autoincrement())
  type      ContactType

  mobile    String
  city      String
  state     String
  pincode   String

  userId    Int         @unique
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
sales     Sale[]
  purchases Purchase[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum AccountType {
  ASSET
  LIABILITY
  EXPENSE
  INCOME
  CAPITAL
}

model Account {
  id           Int         @id @default(autoincrement())
  accountName  String
  accountType AccountType
  sales        Sale[]
  purchases    Purchase[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum JournalType {
  SALES
  PURCHASE
  BANK
  CASH
}

model Journal {
  id           Int         @id @default(autoincrement())
  journalName  String
  journalType JournalType
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Sale {
  id              Int      @id @default(autoincrement())

  customerId      Int
  productId       Int
  accountId       Int

  quantity        Int
  unitPrice       Float
  tax             Float    @default(0)
  totalAmount     Float

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Contact  @relation(fields: [customerId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
  account         Account  @relation(fields: [accountId], references: [id])

  @@index([customerId])
  @@index([productId])
  @@index([accountId])
}

model Purchase {
  id              Int      @id @default(autoincrement())

  vendorId        Int
  productId       Int
  accountId       Int

  quantity        Int
  unitPrice       Float
  totalAmount     Float

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor          Contact  @relation(fields: [vendorId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
  account         Account  @relation(fields: [accountId], references: [id])

  @@index([vendorId])
  @@index([productId])
  @@index([accountId])
}